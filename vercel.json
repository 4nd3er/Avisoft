{
    "version": 2,
    "builds": [
        {
            "src": "/control/",
            "use": "@vercel/python"
        }
    ],
    "routes": [
        {
            "src": "/control/(.*)",
            "dest": "/control/"
        },
        {
            "src": "/(.*)",
            "dest": "/control/"
        },
        {
            "src": "/control/views.py",
            "dest": "/control/"
        }
    ]
}